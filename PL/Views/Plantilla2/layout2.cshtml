@{
}
@section styles {
    <link rel="stylesheet" href="~/css/paginaInicio.css" />
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>

<body>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    <!-- Se añade el id="sidebar" -->
    <div id="sidebar" class="sidebar d-flex flex-column flex-shrink-0 p-3">

        <div class="d-flex justify-content-between align-items-center w-100">
            <a href="/" class="d-flex align-items-center justify-content-center text-decoration-none w-100">
                <div class="logo-ps-side-bar">
                    <img src="~/css/img/logops4k.png" alt="Plan Seguro" />
                </div>
            </a>
            <!-- Botón para cerrar en móvil -->
            <button type="button" class="btn-close d-md-none" id="sidebarClose" aria-label="Close"></button>
        </div>

        <hr class="border-secondary">

        <div class="flex-grow-1 overflow-auto py-3">
            <ul class="nav nav-pills flex-column mb-auto gap-1">
                <li>
                    <a href="#" class="nav-item active d-flex align-items-center" aria-current="page">
                        <i class="bi bi-house-door fs-5 me-3"></i>
                        Inicio
                    </a>
                </li>
                <li>
                    <a href="#" class="nav-item d-flex align-items-center custom-hover">
                        <i class="bi bi-heart-pulse fs-5 me-3"></i>
                        Atención Médica
                    </a>
                </li>
                <li>
                    <a href="#" class="nav-item d-flex align-items-center custom-hover">
                        <i class="bi bi-shield-plus fs-5 me-3"></i>
                        Beneficios
                    </a>
                </li>
                <li>
                    <a href="#" class="nav-item d-flex align-items-center custom-hover">
                        <i class="bi bi-clipboard2 fs-5 me-3"></i>
                        Solicitudes
                    </a>
                </li>
                <li>
                    <a href="#" class="nav-item d-flex align-items-center custom-hover">
                        <i class="bi bi-journal fs-5 me-3"></i>
                        Directorio
                    </a>
                </li>
            </ul>
        </div>

        <hr class="border-secondary">

        <ul class="nav nav-pills flex-column gap-1">
            <li>
                <a href="/" class="nav-item d-flex align-items-center custom-hover">
                    <i class="bi bi-box-arrow-left fs-5 me-3"></i>
                    Cerrar Sesión
                </a>
            </li>
        </ul>
    </div>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <nav class="navbar top-bar sticky-top px-3 py-3 d-flex justify-content-between align-items-center">

            <div class="d-flex align-items-center gap-2">
                <!-- Botón de Menú para móviles (solo visible en pantallas pequeñas) -->
                <button class="btn btn-outline-secondary d-md-none border-0" type="button" id="sidebarToggle">
                    <i class="bi bi-list fs-3 text-dark"></i>
                </button>

                <div class="d-flex flex-column align-items-start">
                    <!-- Flex-wrap permite que el badge baje si no hay espacio -->
                    <div class="welcome-insured d-flex align-items-baseline gap-2 flex-wrap">
                        <h2 class="text-insured m-0">Portal de asegurados</h2>
                        <span class="badge-policy-type badge rounded-pill px-2 py-1" style="background:#08406e; color:#ffffff;">COLECTIVA</span>
                    </div>

                    <div class="d-flex align-items-center gap-1 mt-1 flex-wrap">
                        <span class="welcome m-0">
                            Te damos la bienvenida,
                        </span>
                        <span class="welcome fw-bold m-0" style="color: #243d59">Nombre</span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- Se oculta el logo ContiGo en celulares muy pequeños (d-none d-sm-block) para ahorrar espacio -->
                <div class="logo-ps-contiGo d-none d-sm-block">
                    <img src="~/css/img/logo-contigo.svg" alt="ContiGo" style="height: 35px; width: auto;" />
                </div>

                <div class="user">
                    <a href="#" class="d-flex align-items-center text-dark text-decoration-none">
                        <i class="bi bi-person-circle fs-3 text-secondary"></i>
                    </a>
                </div>
            </div>
        </nav>

        <div class="landing-page-body mt-3">
            <h1>Hello, World!</h1>
        </div>
    </main>

    <!-- Script para abrir/cerrar el menú en celular -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById("sidebar");
            const toggleBtn = document.getElementById("sidebarToggle");
            const closeBtn = document.getElementById("sidebarClose");

            toggleBtn.addEventListener("click", function () {
                sidebar.classList.add("show");
            });

            closeBtn.addEventListener("click", function () {
                sidebar.classList.remove("show");
            });
        });
    </script>
</body>
</html>