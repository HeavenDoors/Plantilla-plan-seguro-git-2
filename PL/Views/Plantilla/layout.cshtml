@section styles {
    <link rel="stylesheet" href="~/css/estiloPlantilla.css" />
}
@{
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Plan Seguro</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>

<body>

    <div class="login-split">

        <div class="encabezado">
            <img src="~/css/img/logops4k.png" alt="Plan Seguro" />
        </div>

        <div class="login-main">

            <div class="login-left">
                <img src="~/css/img/login_insured_portal.png" alt="Asegurados" class="img-logo-asegurados" />
            </div>

            <div class="login-right">
                <div class="login-content">

                    <div class="login-header">
                        <img src="~/css/img/logo-contigo.svg" alt="contiGo" class="img-logo-contiGo" />
                    </div>

                    <span class="text-insured-portal">Portal de Asegurados</span>

                    <h2 class="login-text">Iniciar Sesión</h2>

                    <p class="login-desc">Ingresa tus datos para acceder a la plataforma</p>

                    <form class="login-form">

                        <div class="login-group">
                            <label for="inputUsuario" class="login-label">Correo Electrónico</label>
                            <input type="email" id="inputUsuario" class="login-input" placeholder="ejemplo@planseguro.com.mx" autocomplete="username" />
                        </div>

                        <div class="login-group">
                            <label for="inputPassword" class="login-label">Contraseña</label>
                            <div class="login-password-box">
                                <input type="password" id="inputPassword" class="login-input" placeholder="*********" autocomplete="current-password">
                                <button type="button" class="login-pass-btn" id="togglePassword" tabindex="-1" aria-label="Mostrar/Ocultar contraseña">
                                    <i class="bi bi-eye-slash" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                        </div>

                        <div class="login-actions">
                            <button type="button" class="login-link" id="btnOlvidastePwd">¿Olvidaste tu contraseña?</button>
                        </div>

                        <button class="login-btn-main" id="btnLogin" type="submit" asp-action="layout2" asp-controller="Plantilla2">Continuar</button>

                        <div class="login-extra">
                            <span>¿Todavía no tienes cuenta?</span>
                            <a class="login-link" href="#">Regístrate aquí</a>
                        </div>

                    </form>
                </div>
            </div>

        </div>

    </div>

    <!-- Modal Recuperación -->
    <div class="modal-overlay" id="modalRecuperacion">
        <div class="modal-content">

            <div class="modal-header">
                Recuperación de contraseña
            </div>

            <div class="modal-body">
                <label for="correoRecuperacion">Ingresa el correo con el que te registraste: </label>
                <input type="email" id="correoRecuperacion" placeholder="ejemplo@ejemplo.com" />
            </div>

            <div class="modal-footer">
                <button class="btn-cancelar" onclick="cerrarModal()">Cancelar</button>
                <button class="btn-enviar" onclick="">Enviar</button>
            </div>

        </div>
    </div>

    <script src="/js/login.js"></script>

</body>
</html>